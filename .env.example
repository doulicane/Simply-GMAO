# --- Base de donnees ---
DATABASE_URL=postgresql://simply-gmao:simply-gmao2025@localhost:5432/simply-gmao_gmao?schema=public
DB_USER=simply-gmao
DB_PASSWORD=simply-gmao2025
DB_NAME=simply-gmao_gmao

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- JWT ---
JWT_SECRET=changez_cette_cle_pour_une_cle_securisee_de_32_caracteres_minimum

# --- Application ---
NODE_ENV=production
PORT=3000
CORS_ORIGIN=http://localhost
