# ============================================
# GMAO Simply GMAO — Variables d'environnement
# ============================================

# ------------------------------------------------------------------
# Serveur
# ------------------------------------------------------------------
# Port d'ecoute de l'API Node.js (interieur conteneur)
PORT=3000

# Environnement d'execution : development | production
NODE_ENV=production

# ------------------------------------------------------------------
# Base de donnees PostgreSQL
# ------------------------------------------------------------------
# URL complete de connexion Prisma (format : postgresql://USER:PASSWORD@HOST:PORT/DB)
DATABASE_URL=postgresql://gmao:gmao_secret_2025@postgres:5432/simply-gmao_gmao

# ------------------------------------------------------------------
# Redis (cache + file d'attente BullMQ)
# ------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# ------------------------------------------------------------------
# Securite — JWT
# ------------------------------------------------------------------
# Cle secrete pour signer les tokens (MINIMUM 32 caracteres, aleatoire)
# Generer avec : openssl rand -base64 64
JWT_SECRET=changez_cette_cle_pour_une_cle_aleatoire_forte_de_64_caracteres_minimum

# Duree de validite du token d'acces (ex: 15m = 15 minutes)
JWT_ACCESS_EXPIRATION=15m

# Duree de validite du token de rafraichissement (ex: 7d = 7 jours)
JWT_REFRESH_EXPIRATION=7d

# ------------------------------------------------------------------
# Securite — Authentification
# ------------------------------------------------------------------
# Cout du hash bcrypt (10-12 recommande en production)
BCRYPT_ROUNDS=12

# ------------------------------------------------------------------
# Upload fichiers
# ------------------------------------------------------------------
# Repertoire de stockage des fichiers uploads (monte comme volume Docker)
UPLOAD_DIR=/data/uploads

# Taille maximale d'upload par fichier (en octets) — 20 Mo
MAX_FILE_SIZE=20971520

# ------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------
# Niveau de log : error | warn | info | debug
LOG_LEVEL=info

# ------------------------------------------------------------------
# Maintenance preventive (jobs automatiques)
# ------------------------------------------------------------------
# Expression cron pour la generation auto des BT preventifs (defaut : toutes les heures)
PREVENTIVE_CRON=0 * * * *

# Nombre de jours d'anticipation pour generer un BT preventif
PREVENTIVE_ALERT_DAYS=3

# ------------------------------------------------------------------
# Notifications
# ------------------------------------------------------------------
# Activer les notifications internes (push simulees via WebSocket/SSE)
ENABLE_NOTIFICATIONS=true

# ------------------------------------------------------------------
# Configuration reseau
# ------------------------------------------------------------------
# URL publique du serveur (pour les liens QR codes, emails)
PUBLIC_URL=https://gmao.simply-gmao.local

# CORS — Origines autorisees (separees par virgule)
# En local/LAN : autoriser toutes les origines du reseau usine
CORS_ORIGIN=https://gmao.simply-gmao.local,http://localhost:5173

# ------------------------------------------------------------------
# Backups
# ------------------------------------------------------------------
# Chemin du repertoire de backups sur le host
BACKUP_DIR=/backups
